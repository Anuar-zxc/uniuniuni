# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
ADMIN_EMAIL=you@example.com

# AI — default: alem.ai (OpenAI-compatible), model qwen3-8. Use AI_PROVIDER=mock to run without keys.
AI_PROVIDER=alem
AI_MODEL=qwen3-8
ALEM_API_KEY=
ALEM_BASE_URL=https://llm.alem.ai/v1
# Optional alternatives: openai | anthropic | gemini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Evaluate each answer N times and take the median (consistency layer); 1 = cheapest
AI_EVAL_SAMPLES=1

# Encrypt uploaded CVs at rest (generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
FILE_ENCRYPTION_KEY=

# Payments: sandbox in dev; stripe when keys are set. Kaspi / Freedom Pay / Halyk / Paddle share the provider interface.
PAYMENT_PROVIDER_DEFAULT=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=
POSTGRES_PASSWORD=offerready
S3_ACCESS_KEY=offerready
S3_SECRET_KEY=offerready-secret
